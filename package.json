{
  "name": "fernando-notion",
  "productName": "Fernando Notion",
  "version": "1.0.1",
  "description": "A Notion-style workspace for notes, projects, calendars and agendas. Everything auto-saves to your computer.",
  "author": "Fernando Notion",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n web,app -c blue,green \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.fernando.notion",
    "productName": "Fernando Notion",
    "copyright": "Copyright © 2026 Fernando Notion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fernando Notion",
      "artifactName": "Fernando-Notion-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Fernando-Notion-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Fernando-Notion-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Fernando Notion"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Fernando-Notion-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@blocknote/code-block": "^0.57.0",
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@floating-ui/react": "^0.27.20",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "emoji-picker-react": "^5.1.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1",
    "zustand": "^5.1.0"
  }
}
